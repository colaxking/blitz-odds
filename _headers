# The app bundle and stylesheet carry a content hash in their query string
# (`/js/app.js?v=<hash>`, stamped by scripts/build-app.mjs), so the URL
# changes whenever the content does. That makes them safe to cache for a
# year: a visitor who has seen one page of the site has the bundle for every
# other page, and a new build is a new URL. Everything else keeps Netlify's
# default (max-age=0, must-revalidate with ETag).
/js/app.js
  Cache-Control: public, max-age=31536000, immutable
/css/app.css
  Cache-Control: public, max-age=31536000, immutable
# Pinned React 18.2.0 UMD builds; the path changes if the version does.
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The data seeds the app fetches at boot (see bootApp in src/app.jsx) change
# with every refresh job commit, so they stay on revalidation - but allow a
# short shared-cache window so the CDN absorbs the per-page-view hits.
/data/history.json
  Cache-Control: public, max-age=300, must-revalidate
/data/impact-players.json
  Cache-Control: public, max-age=300, must-revalidate
